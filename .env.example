# Application runtime
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
ADMIN_EMAIL=
ADMIN_PHONE=
EMERGENCY_NATIONAL_SOS=112
EMERGENCY_POLICE=100

# AI / app services
GEMINI_API_KEY=
# Generate independent random secrets of at least 32 characters. Backend only.
OTP_HMAC_SECRET=
SESSION_SECRET=
BANK_ACCOUNT_ENCRYPTION_KEY=

# Supabase (server-side only; never use VITE_ prefixes for service-role values)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Firebase Admin / backend
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=

# Firebase Web client defaults
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_VAPID_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# APITXT
APITXT_API_KEY=
APITXT_BASE_URL=https://apitxt.com

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Cloud / Cloud Run
GCP_PROJECT_ID=
GCP_REGION=asia-south1
CLOUD_RUN_SERVICE_NAME=pairuptoday-api

# Hosting / deployment
WEB_PUBLIC_URL=https://pairuptoday.com
ADMIN_PUBLIC_URL=https://admin.pairuptoday.com